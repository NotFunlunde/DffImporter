<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BfbbImport</RootNamespace>
  </PropertyGroup>

  <!-- Include Runtime source files (excluding ClumpBuilder which needs deep Unity APIs) -->
